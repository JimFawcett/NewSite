#!/bin/sh
# Python_TextFinder - launches the TextFinder module with the four src folders on PYTHONPATH

here=$(cd "$(dirname "$0")" && pwd)
PYTHONPATH="$here/Python_Spec_driven_Cmdline/src:$here/Python_Spec_driven_Dirnav/src:$here/Python_Spec_driven_Output/src:$here/Python_Spec_driven_TextFinder_Entry/src"
export PYTHONPATH
exec python3 -m python_textfinder_entry "$@"
